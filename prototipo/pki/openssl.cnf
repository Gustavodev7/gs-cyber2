# Configuracao minima da CA do projeto Vila Aurora.
[ ca ]
default_ca = CA_default

[ CA_default ]
dir               = .
certs             = $dir/certs
crl_dir           = $dir/crl
new_certs_dir     = $dir/newcerts
database          = $dir/index.txt
serial            = $dir/serial
crlnumber         = $dir/crlnumber
certificate       = $dir/ca/ca.cert.pem
private_key       = $dir/ca/ca.key.pem
crl               = $dir/crl/vila-aurora.crl.pem
default_md        = sha256
default_days      = 375
default_crl_days  = 30
policy            = policy_loose
x509_extensions   = usr_cert
# permite reemitir o mesmo CN na rotacao (o antigo e revogado logo em seguida)
unique_subject    = no

[ policy_loose ]
countryName             = optional
stateOrProvinceName     = optional
organizationName        = optional
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

# Certificado de cliente (dispositivo, no de borda, SOAR): so autenticacao de cliente.
[ usr_cert ]
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = clientAuth
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer

# Certificado de servidor (broker MQTT, ingestao HTTPS). O subjectAltName vem do
# arquivo de extensao gerado por emitir_dispositivo.sh (opcao --servidor).
[ server_cert ]
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
